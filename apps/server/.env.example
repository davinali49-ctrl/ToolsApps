# Salin menjadi .env lalu sesuaikan bila perlu.
PORT=8787
HOST=0.0.0.0

# Batas unggah dan masa simpan hasil (menit)
MAX_UPLOAD_MB=200
JOB_TTL_MINUTES=120

# Lokasi berkas pekerjaan. Kosongkan untuk folder temp OS.
DATA_DIR=

# Origin yang diizinkan. Gunakan * untuk pengembangan lokal.
CORS_ORIGIN=*

# Path absolut bila deteksi otomatis gagal.
# Windows: C:\Program Files\LibreOffice\program\soffice.exe
SOFFICE_PATH=
YTDLP_PATH=
FFMPEG_PATH=

# Batas durasi media yang boleh diunduh (menit)
MAX_MEDIA_MINUTES=180
LOG_LEVEL=info
